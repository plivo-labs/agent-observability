PORT=9090

# Basic auth (optional — legacy auth path, when both are set Basic credentials
# are accepted on native ingest routes)
AGENT_OBSERVABILITY_USER=
AGENT_OBSERVABILITY_PASS=

# LiveKit-native auth (optional — when both are set, native ingest routes
# accept Bearer JWTs minted by the LiveKit SDK with the same key/secret pair.
# agent-transport >= 0.1.10 uploads via this path; older clients use Basic
# above. Either auth mode on its own is enough.)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Escape hatch: allow booting with NO auth configured (neither Basic nor
# LiveKit). Off by default — the server otherwise refuses to start rather than
# silently expose ingest + the dashboard API. Set true only for local dev or a
# trusted private network.
ALLOW_UNAUTHENTICATED=false

# Postgres (required)
# Postgres. Required in the default (self-contained) mode; OPTIONAL when SIM_PERSIST=false
# (stateless generator — Plivo / bring-your-own-backend — boots with no database).
DATABASE_URL=postgres://user:password@localhost:5432/agent_observability
AUTO_MIGRATE=false

# S3 recording upload (optional — when set, audio recordings are uploaded to S3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PREFIX=recordings

# Alert sweeper placement. 'inline' (default) runs it inside the API process.
# Set 'off' when running the dedicated worker entrypoint (bun src/worker.ts)
# so exactly one sweeper is active.
ALERT_SWEEPER=inline

# Eval sweeper placement — judges ingested sessions that carry an agent
# config. One flag read by both processes: 'inline' (default) runs it in the
# API; 'worker' runs it in the dedicated worker; 'off' disables it everywhere.
EVAL_SWEEPER=inline

# Event-kick: judge a session the instant its ingest completes instead of on
# the next poll tick. Only fires in the process running the sweeper inline;
# 'off' falls back to poll-only (a latency switch — never changes WHAT gets
# judged, only HOW SOON).
EVAL_EVENT_KICK=on

# Eval sweeper concurrency / throughput (consul-tunable; defaults below match
# the prior hardcoded behavior). EVAL_MAX_CONCURRENT_JUDGE_CALLS is the TRUE
# ceiling — a global cap on simultaneous LLM judge calls shared by the poller
# AND the event-kick. Raising the session/kick caps WITHOUT raising it is a
# no-op (every session's ~12-13 judge calls funnel through it); size the ceiling
# against the judge LLM endpoint's rate limit.
EVAL_MAX_CONCURRENT_SESSIONS=3
EVAL_MAX_CONCURRENT_KICKS=3
EVAL_MAX_CONCURRENT_JUDGE_CALLS=10
EVAL_MAX_PER_SWEEP=20
EVAL_SWEEP_INTERVAL_MS=20000
# Per-session spend ceiling: judge at most this many nodes per session (the
# busiest by turn count). The caps above bound the RATE; this bounds one
# session's BILL (~5 LLM calls per judged node). Conversation judges
# always see the full transcript.
EVAL_MAX_JUDGED_NODES=30

# CORS allow-list for the /api/* dashboard endpoints. Comma-separated
# origins. Defaults to "*" (any origin). In production the dashboard is
# served same-origin, so set this only when it runs on a different origin.
# CORS_ALLOWED_ORIGINS=https://obs.example.com,http://localhost:5173

# ── LLM provider (simulation scenario generator) ─────────────────────────────
# Provider-neutral: src/llm/completeJSON dispatches to the adapter named here.
# Set the key for the selected provider only. OPENAI_BASE_URL points the OpenAI
# adapter at an OpenAI-compatible gateway (Azure OpenAI / OpenRouter / a local
# server). Defaults work for unit tests, which inject a mock LLM.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# API root (the part before /chat/completions or /responses). Vanilla OpenAI:
# https://api.openai.com/v1 . A gateway sets its own root (e.g. an Azure resource's
# .../openai/v1). Leave empty to use the OpenAI default.
OPENAI_BASE_URL=
# Wire format for the OpenAI adapter — both are standard OpenAI APIs:
#   chat       (default) Chat Completions: POST {base}/chat/completions
#   responses            Responses API:    POST {base}/responses
# Use "responses" for gateways that only expose the Responses API.
OPENAI_API_MODE=chat
# Auth header style: "bearer" (default; vanilla OpenAI) or "api-key" (Azure-style gateways).
OPENAI_AUTH_STYLE=bearer
# Per-role model overrides (empty = the adapter's built-in default).
JUDGE_MODEL=
SIMULATOR_MODEL=
GENERATOR_MODEL=
# Per-role RATE-LIMIT fallback deployment (empty = off, the default). When 429s use
# up a call's retries, completeJSON spends its LAST attempt here instead of failing.
# Retry-After covers a transient limit; this covers an exhausted quota window, where
# waiting cannot help. Set to a deployment name, not a model id.
# Leave JUDGE_MODEL_FALLBACK EMPTY: verdict rows don't record which model judged
# them, so a mid-run switch yields a silently mixed verdict set — and the eval
# sweeper already re-runs 429'd sessions. See schema.ts for the full reasoning.
JUDGE_MODEL_FALLBACK=
SIMULATOR_MODEL_FALLBACK=
GENERATOR_MODEL_FALLBACK=
# Reasoning effort for the judge role (inherit|none|low|medium|high), sent as
# `reasoning: {effort}` on the Responses API. "none" matches the reference engine
# and is what makes the per-judge output caps (1500-5000, copied from it)
# sufficient — at higher effort, invisible reasoning tokens bill against the same
# max_output_tokens budget and long sessions truncate, losing their evals.
# Raise this only together with those caps. "inherit" omits the parameter and
# lets the deployment's own default decide — use it when a deployment rejects
# explicit values ("none" is not universally valid across gpt-5.x deployments).
JUDGE_REASONING_EFFORT=none
# completeJSON request hardening: per-attempt timeout (ms) + retry count.
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# ── Simulation engine ────────────────────────────────────────────────────────
# Capability-gated, NOT all-or-nothing: generation needs only an LLM key (above);
# runs need REDIS_URL + LIVEKIT_SIM_TURN_URL; the SQS consumer additionally needs
# SIM_EVAL_SQS_QUEUE_URL. SIM_EVAL_SQS_QUEUE_URL is the run-dispatch plug-in (Plivo) —
# leave it unset for a generation-only deploy.
# AWS credentials come from the standard AWS provider chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env, shared config, or an instance role)
# — never put them here.
SIM_EVAL_SQS_QUEUE_URL=
REDIS_URL=
# Set true when REDIS_URL points at a Redis Cluster (Plivo prod). The
# SIM_EVAL:{run_uuid}:* hash tags + the worker's 3-key Lua gate require cluster mode
# to co-locate keys; default false = standalone (dev / dockerized E2E).
REDIS_CLUSTER=false
AWS_REGION=us-east-1
# Scenario-generation model (default gpt-5.5). On an Azure/gateway deployment this is a
# DEPLOYMENT name, not an OpenAI model id — set it to whatever your endpoint serves.
SIM_EVAL_SCENARIO_GENERATION_MODEL=gpt-5.5
# Reasoning effort for the two generation calls: inherit | none | low | medium | high.
# "inherit" (default) does not send the parameter at all, so the deployment's own default
# applies — leave it there unless you are deliberately measuring the dial.
#   • planner — the hard flow-comprehension call. An equivalent dial on the reference
#     engine measured as a NULL result (latency was bound by output-token throughput,
#     not reasoning), so expect little from this one.
#   • writer  — executes an already-fixed plan, and runs uncapped/streaming, so this is
#     the safer and less-tested place to trade deliberation for speed.
# Only sent on the Responses transport (OPENAI_API_MODE=responses).
SIM_EVAL_PLANNER_REASONING_EFFORT=inherit
SIM_EVAL_WRITER_REASONING_EFFORT=inherit
# Hard per-request scenario ceiling. The request schema allows up to 100, but
# the default policy caps it at 50; a generate request asking for more is
# rejected with 400. Raise (up to 100) only if a deployment needs it.
MAX_SCENARIOS_PER_REQUEST=50
# Concurrent scenario-generation requests allowed per process; over the limit
# the request gets 429 (each generation is an expensive multi-call LLM fan-out).
GEN_MAX_CONCURRENT=2

# Scenario-library persistence mode (how AO stores generated scenarios):
#   true  (default) — SELF-CONTAINED (OSS): AO writes each scenario to its own Postgres
#                     (ao_simulation_scenarios) and serves the library API. Needs DATABASE_URL.
#   false           — STATELESS (bring-your-own-backend): AO streams scenarios but writes
#                     NO database; the host service persists them. No DATABASE_URL needed.
# The per-request `?persist=true|false` query param overrides this default.
SIM_PERSIST=true

# ── Run engine (the ported reference simulation loop) ────────────────────────
# Runs are dispatched only via the SQS consumer (bun src/worker.ts), which drains run
# messages produced by the orchestrator service; AO stays stateless on the run path
# (Redis-only). Needs SIM_EVAL_SQS_QUEUE_URL + REDIS_URL + LIVEKIT_SIM_TURN_URL.
# Redis key prefix for the run-scoped keys (FLOW_JSON / SCENARIO_EXPECTED_COUNT /
# RESULTS / the Lua completion counters). Default SIM_EVAL matches the orchestrator
# service on a shared Redis; override for an OSS deploy with its own Redis.
SIM_REDIS_PREFIX=SIM_EVAL
# Base URL of the agent runtime. The engine POSTs each turn to
# {LIVEKIT_SIM_TURN_URL}/v1/simulation/session/turn. Required for the run engine.
LIVEKIT_SIM_TURN_URL=
# Optional Basic-auth credentials for the /turn endpoint; unset = no Authorization
# header (unauthenticated private network).
LIVEKIT_SIM_TURN_USER=
LIVEKIT_SIM_TURN_PASS=
# UserSimulator (simulated caller) LLM model. Falls back to the generation model
# above when unset.
USER_SIMULATOR_MODEL=
# Reasoning effort for the UserSimulator: inherit | none | low | medium | high.
# "inherit" (default) omits the parameter. This call is billed and timed per simulated
# TURN, so the setting multiplies across a whole conversation — the opposite of the
# generation dials, which apply once per request. Sent as a flat `reasoning_effort` on
# Chat Completions, which is the transport this role always uses.
SIM_USER_REASONING_EFFORT=inherit
# Scenarios one worker process runs concurrently (SQS consumer fan-out; default 8).
SIM_WORKER_CONCURRENCY=8
# Interval (ms) between generation SSE heartbeats — keep well under any downstream
# idle-reset window (relay Redis / proxies). Default 5000.
SIM_GEN_HEARTBEAT_MS=5000

# ── Multi-tenant / webhook hardening (optional) ───────────────────────────────
# Require the gateway-injected `auth-id` header on scenario DELETE routes (400 when
# absent) instead of running unscoped. Set true on multi-tenant deploys.
SIM_REQUIRE_TENANT_HEADER=false
# SSRF-guard escape hatch for alert webhooks: comma-separated exact hostnames, IPs,
# or IPv4 CIDRs allowed to be non-public receivers. Empty = strict guard for all.
WEBHOOK_URL_ALLOWLIST=
